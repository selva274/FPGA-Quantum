`timescale 1 ps/ 1 ps

module adder (
	A,
	B,
	Sum,
	Carry);
input 	A;
input 	B;
output 	Sum;
output 	Carry;

// Design Ports Information
// Sum	=>  Location: PIN_J16,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Carry	=>  Location: PIN_L14,	 I/O Standard: 2.5 V,	 Current Strength: Default
// A	=>  Location: PIN_H16,	 I/O Standard: 2.5 V,	 Current Strength: Default
// B	=>  Location: PIN_L15,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \~QUARTUS_CREATED_GND~I_combout ;
wire \B~input_o ;
wire \A~input_o ;
wire \Sum~0_combout ;
wire \Carry~0_combout ;


// Location: IOOBUF_X54_Y15_N56
cyclonev_io_obuf \Sum~output (
	.i(\Sum~0_combout ),
	.oe(vcc),
	.dynamicterminationcontrol(gnd),
	.seriesterminationcontrol(16'b0000000000000000),
	.parallelterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(Sum),
	.obar());
// synopsys translate_off
defparam \Sum~output .bus_hold = "false";
defparam \Sum~output .open_drain_output = "false";
defparam \Sum~output .shift_series_termination_control = "false";
// synopsys translate_on

// Location: IOOBUF_X54_Y15_N5
cyclonev_io_obuf \Carry~output (
	.i(\Carry~0_combout ),
